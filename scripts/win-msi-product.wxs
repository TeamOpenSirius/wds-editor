<?xml version="1.0" encoding="utf-8"?>
<!--
  Product shell for dist/wds-win-x86_64.msi.
  File components are harvested at packaging time via wixl-heat, then
  scripts/win-msi-harvest.py pins wds_editor.exe + private DLLs under INSTALLDIR.
  Config is NOT installed: runtime writes %LOCALAPPDATA%\WDS\config\config.yml.
  UI: scripts/win-msi-ui.wxs (install dir + shortcuts + progress + exit).

  Language must stay 1033 to match wixl Template summary (x64;1033).

  Shortcuts are NOT MSI Shortcut/Feature items (wixl defaults Advertise=yes,
  and overlay upgrades migrate those feature states). ApplyUserShortcuts
  creates/deletes per-machine .lnk files from CREATE_* after InstallFiles.

  Remembering checkboxes does NOT go through a UI-sequence DLL:
  AppSearch (RegistrySearch) loads HKLM Create*Shortcut into CREATE_*,
  WriteRegistryValues persists [CREATE_*].
  package-target.sh appends CREATE_* / WDS_INSTALLDIR to SecureCustomProperties
  so the elevated Execute sequence sees the UI values.

  InstallDirDlg uses Edit (not PathEdit). PathEdit on a not-yet-created
  INSTALLDIR can clear the property; Edit plus InitWdsInstallDir keeps it.

  Upgrades:
  - Same UpgradeCode + MajorUpgrade + RemoveExistingProducts after
    InstallFinalize. Early REP + same ProductVersion skips InstallFiles
    (costing sees the old files) then deletes them — overlay needs Repair.
  - Path-stable component GUIDs so the old uninstall does not delete the
    files the new product just copied.
  - REINSTALLMODE=amus so same-version dest rebuilds actually replace the exe.
  - HKLM InstallDir is remembered so UpdateDlg installs over the existing folder.
  - HKLM Create*Shortcut prefs are remembered so ShortcutsDlg defaults match
    the last choice; ApplyUserShortcuts honors the new checkboxes.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="WDS Editor"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="WDS"
           UpgradeCode="A7E3C2B1-9F4D-4E8A-9C6B-1D2E3F4A5B6C">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="WDS Chart Editor (Windows x64)"
             Comments="Self-contained editor; preferences live under LocalAppData"/>

    <!-- Remove previous product after the new files are committed.
         Same-version overlays (AllowSameVersionUpgrades, ProductVersion stays
         1.0.0-beta1) cost while the old files are still on disk and then skip
         InstallFiles; an early RemoveExistingProducts deletes those files and
         the upgrade needs Repair. Late REP + path-stable component GUIDs keep
         the new copy and only drop leftovers. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of WDS Editor is already installed."
                  AllowSameVersionUpgrades="yes"/>
    <MediaTemplate EmbedCab="yes"/>

    <Property Id="ARPPRODUCTICON" Value="WdsEditorIcon"/>
    <!-- Force overwrite on same-version overlays so dest rebuilds actually replace the exe. -->
    <Property Id="REINSTALLMODE" Value="amus"/>
    <!-- Fresh install defaults to both shortcuts on; AppSearch overlays HKLM prefs. -->
    <Property Id="CREATE_DESKTOP_SHORTCUT" Value="1" Secure="yes">
      <RegistrySearch Id="FindDesktopPref"
                      Root="HKLM"
                      Key="Software\WDS\Editor"
                      Name="CreateDesktopShortcut"
                      Type="raw"
                      Win64="yes"/>
    </Property>
    <Property Id="CREATE_STARTMENU_SHORTCUT" Value="1" Secure="yes">
      <RegistrySearch Id="FindStartMenuPref"
                      Root="HKLM"
                      Key="Software\WDS\Editor"
                      Name="CreateStartMenuShortcut"
                      Type="raw"
                      Win64="yes"/>
    </Property>
    <!-- Parent folder chosen in BrowseDlg; CustomAction appends "\WDS Editor". -->
    <Property Id="WDSINSTALLPARENT" Secure="yes"/>
    <!-- Edit (not PathEdit) binds here. Copied to INSTALLDIR on Next. -->
    <Property Id="WDS_INSTALLDIR" Secure="yes"/>
    <!-- Remembered install path from the previous MSI (Win64 HKLM). -->
    <Property Id="WDS_PREVIOUS_INSTALL" Secure="yes">
      <RegistrySearch Id="FindWdsInstallDir"
                      Root="HKLM"
                      Key="Software\WDS\Editor"
                      Name="InstallDir"
                      Type="raw"
                      Win64="yes"/>
    </Property>
    <CustomAction Id="SetInstallDirFromBrowse"
                  Property="INSTALLDIR"
                  Value="[WDSINSTALLPARENT]\WDS Editor"/>
    <CustomAction Id="SetInstallDirFromPrevious"
                  Property="INSTALLDIR"
                  Value="[WDS_PREVIOUS_INSTALL]"/>
    <CustomAction Id="InitWdsInstallDir"
                  Property="WDS_INSTALLDIR"
                  Value="[INSTALLDIR]"/>
    <CustomAction Id="ApplyWdsInstallDir"
                  Property="INSTALLDIR"
                  Value="[WDS_INSTALLDIR]"/>
    <CustomAction Id="SetArpInstallLocation"
                  Property="ARPINSTALLLOCATION"
                  Value="[INSTALLDIR]"/>

    <Binary Id="WdsMsiCa" SourceFile="$(var.SourceDir)/wds_msi_ca.dll"/>
    <!-- Immediate: pack properties for the deferred CA (elevated, after REP). -->
    <CustomAction Id="SetApplyShortcutsData"
                  Property="ApplyUserShortcuts"
                  Value="[INSTALLDIR]|[CREATE_DESKTOP_SHORTCUT]|[CREATE_STARTMENU_SHORTCUT]|[REMOVE]|[UPGRADINGPRODUCTCODE]"/>
    <CustomAction Id="ApplyUserShortcuts"
                  BinaryKey="WdsMsiCa"
                  DllEntry="ApplyUserShortcuts"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <UIRef Id="WdsUI"/>

    <InstallUISequence>
      <Custom Action="SetInstallDirFromPrevious" After="AppSearch">
        WDS_PREVIOUS_INSTALL AND NOT Installed
      </Custom>
      <!-- After costing so INSTALLDIR is the resolved Program Files path.
           Dialogs are After this action so the Edit field is never empty. -->
      <Custom Action="InitWdsInstallDir" After="CostFinalize">
        NOT WDS_INSTALLDIR
      </Custom>
    </InstallUISequence>
    <InstallExecuteSequence>
      <!-- After InstallFinalize: copy/overwrite first, then uninstall the old
           product. wixl MajorUpgrade also adds a dep on InstallValidate; the
           extra After=InstallFinalize wins in the topo sort. -->
      <RemoveExistingProducts After="InstallFinalize"/>
      <Custom Action="SetInstallDirFromPrevious" After="AppSearch">
        WDS_PREVIOUS_INSTALL AND NOT Installed
      </Custom>
      <Custom Action="InitWdsInstallDir" After="CostFinalize">
        NOT WDS_INSTALLDIR
      </Custom>
      <!-- Only copy a user-typed path on a fresh install. Never apply a
           PathEdit-cleared / empty value over a valid Directory-table path. -->
      <Custom Action="ApplyWdsInstallDir" After="InitWdsInstallDir">
        WDS_INSTALLDIR AND NOT Installed AND NOT WDS_PREVIOUS_INSTALL AND NOT WIX_UPGRADE_DETECTED AND NOT WIX_SAME_VERSION_UPGRADE_DETECTED
      </Custom>
      <Custom Action="SetArpInstallLocation" After="InstallValidate">
        NOT REMOVE="ALL"
      </Custom>
      <!-- Snapshot after InstallInitialize (in-script). Always run so Repair
           reapplies .lnk files from AppSearch prefs, and uninstall deletes them. -->
      <Custom Action="SetApplyShortcutsData" After="InstallInitialize">
        1
      </Custom>
      <Custom Action="ApplyUserShortcuts" After="InstallFiles" Before="InstallFinalize">
        1
      </Custom>
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="WDS Editor"/>
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="RegistryInstallDir" Guid="E0F1A2B3-4C5D-6E7F-8091-A2B3C4D5E6F7" Win64="yes">
        <RegistryValue Root="HKLM"
                       Key="Software\WDS\Editor"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLDIR]"
                       KeyPath="yes"/>
      </Component>
      <!-- MSI-owned prefs (WriteRegistryValues). AppSearch reads these back
           on the next overlay. Do not rely on a UI-sequence CA to persist. -->
      <Component Id="ShortcutPrefs" Guid="A91B2C3D-4E5F-6780-91A2-B3C4D5E6F708" Win64="yes">
        <RegistryValue Root="HKLM"
                       Key="Software\WDS\Editor"
                       Name="CreateDesktopShortcut"
                       Type="string"
                       Value="[CREATE_DESKTOP_SHORTCUT]"
                       KeyPath="yes"/>
        <RegistryValue Root="HKLM"
                       Key="Software\WDS\Editor"
                       Name="CreateStartMenuShortcut"
                       Type="string"
                       Value="[CREATE_STARTMENU_SHORTCUT]"/>
      </Component>
    </DirectoryRef>

    <!-- Prefer BMP-only ICO generated at package time (PNG-compressed ICO can crash msiexec UI). -->
    <Icon Id="WdsEditorIcon" SourceFile="$(var.SourceDir)/wds-msi.ico"/>

    <Feature Id="ProductFeature" Title="WDS Editor" Level="1" AllowAdvertise="no" Absent="disallow">
      <ComponentGroupRef Id="ProductFiles"/>
      <ComponentRef Id="RegistryInstallDir"/>
      <ComponentRef Id="ShortcutPrefs"/>
    </Feature>
  </Product>
</Wix>
