<?xml version="1.0" encoding="utf-8"?>
<!--
  Product shell for dist/wds-win-x86_64.msi.
  File components are harvested at packaging time via wixl-heat into a sibling fragment.
  Config is NOT installed: runtime writes %LOCALAPPDATA%\WDS\config\config.yml.
  UI: scripts/win-msi-ui.wxs (install dir + shortcuts + progress + exit).

  Language must stay 1033 to match wixl Template summary (x64;1033).
  Shortcut features are toggled via AddLocal/Remove ControlEvents (wixl lacks
  Component/Feature Condition), then re-applied in Execute by
  ApplyShortcutFeatureStates (DLL CA) so MigrateFeatureStates cannot wipe them.

  Upgrades:
  - Same UpgradeCode + MajorUpgrade removes the previous product (single ARP entry).
  - HKLM InstallDir is remembered so UpdateDlg installs over the existing folder.
  - HKLM Create*Shortcut prefs are remembered so ShortcutsDlg defaults match the
    last install/update; the user can change them and the new choice is saved.

  wixl does not honor Property/@Secure for SecureCustomProperties (and setting that
  property in the .wxs crashes wixl). package-target.sh patches the Property table
  after wixl so CREATE_* survive the UI→Execute handoff.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="WDS Editor"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="WDS"
           UpgradeCode="A7E3C2B1-9F4D-4E8A-9C6B-1D2E3F4A5B6C">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="WDS Chart Editor (Windows x64)"
             Comments="Self-contained editor; preferences live under LocalAppData"/>

    <!-- Remove previous product before installing so Apps & Features stays a single entry.
         AllowSameVersionUpgrades: same ProductVersion still replaces (sets
         WIX_SAME_VERSION_UPGRADE_DETECTED in wixl / msitools). -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of WDS Editor is already installed."
                  AllowSameVersionUpgrades="yes"/>
    <MediaTemplate EmbedCab="yes"/>

    <Property Id="ARPPRODUCTICON" Value="WdsEditorIcon"/>
    <!-- Fresh install defaults to both shortcuts on; AppSearch/CAs overlay prior prefs. -->
    <Property Id="CREATE_DESKTOP_SHORTCUT" Value="1" Secure="yes"/>
    <Property Id="CREATE_STARTMENU_SHORTCUT" Value="1" Secure="yes"/>
    <!-- Parent folder chosen in BrowseDlg; CustomAction appends "WDS Editor". -->
    <Property Id="WDSINSTALLPARENT" Secure="yes"/>
    <!-- Remembered install path from the previous MSI (Win64 HKLM). -->
    <Property Id="WDS_PREVIOUS_INSTALL" Secure="yes">
      <RegistrySearch Id="FindWdsInstallDir"
                      Root="HKLM"
                      Key="Software\WDS\Editor"
                      Name="InstallDir"
                      Type="raw"
                      Win64="yes"/>
    </Property>
    <!-- Explicit 0/1 prefs written on every install/update (machine-wide). -->
    <Property Id="WDS_REG_DESKTOP_PREF" Secure="yes">
      <RegistrySearch Id="FindDesktopShortcutPref"
                      Root="HKLM"
                      Key="Software\WDS\Editor"
                      Name="CreateDesktopShortcut"
                      Type="raw"
                      Win64="yes"/>
    </Property>
    <Property Id="WDS_REG_STARTMENU_PREF" Secure="yes">
      <RegistrySearch Id="FindStartMenuShortcutPref"
                      Root="HKLM"
                      Key="Software\WDS\Editor"
                      Name="CreateStartMenuShortcut"
                      Type="raw"
                      Win64="yes"/>
    </Property>
    <!-- Legacy KeyPath markers from older MSIs (present only when that shortcut was installed). -->
    <Property Id="WDS_REG_DESKTOP_LEGACY" Secure="yes">
      <RegistrySearch Id="FindDesktopShortcutLegacy"
                      Root="HKCU"
                      Key="Software\WDS\Editor"
                      Name="DesktopShortcut"
                      Type="raw"/>
    </Property>
    <Property Id="WDS_REG_STARTMENU_LEGACY" Secure="yes">
      <RegistrySearch Id="FindStartMenuShortcutLegacy"
                      Root="HKCU"
                      Key="Software\WDS\Editor"
                      Name="StartMenuShortcut"
                      Type="raw"/>
    </Property>
    <CustomAction Id="SetInstallDirFromBrowse"
                  Property="INSTALLDIR"
                  Value="[WDSINSTALLPARENT]WDS Editor"/>
    <CustomAction Id="SetInstallDirFromPrevious"
                  Property="INSTALLDIR"
                  Value="[WDS_PREVIOUS_INSTALL]"/>
    <!-- Apply remembered shortcut prefs before ShortcutsDlg (UI sequence). -->
    <CustomAction Id="ApplyDesktopPrefFromReg"
                  Property="CREATE_DESKTOP_SHORTCUT"
                  Value="[WDS_REG_DESKTOP_PREF]"/>
    <CustomAction Id="ApplyDesktopPrefLegacyOff"
                  Property="CREATE_DESKTOP_SHORTCUT"
                  Value="0"/>
    <CustomAction Id="ApplyStartMenuPrefFromReg"
                  Property="CREATE_STARTMENU_SHORTCUT"
                  Value="[WDS_REG_STARTMENU_PREF]"/>
    <CustomAction Id="ApplyStartMenuPrefLegacyOff"
                  Property="CREATE_STARTMENU_SHORTCUT"
                  Value="0"/>
    <!-- Normalize checkbox (set/"1" vs cleared) to 0/1 for HKLM persistence. -->
    <CustomAction Id="PersistDesktopShortcutOn"
                  Property="WDS_DESKTOP_SHORTCUT_PREF"
                  Value="1"/>
    <CustomAction Id="PersistDesktopShortcutOff"
                  Property="WDS_DESKTOP_SHORTCUT_PREF"
                  Value="0"/>
    <CustomAction Id="PersistStartMenuShortcutOn"
                  Property="WDS_STARTMENU_SHORTCUT_PREF"
                  Value="1"/>
    <CustomAction Id="PersistStartMenuShortcutOff"
                  Property="WDS_STARTMENU_SHORTCUT_PREF"
                  Value="0"/>
    <!-- After MigrateFeatureStates: force Desktop/StartMenu features from CREATE_*. -->
    <Binary Id="WdsMsiCa" SourceFile="$(var.SourceDir)/wds_msi_ca.dll"/>
    <CustomAction Id="ApplyShortcutFeatureStates"
                  BinaryKey="WdsMsiCa"
                  DllEntry="ApplyShortcutFeatureStates"/>

    <UIRef Id="WdsUI"/>

    <InstallUISequence>
      <Custom Action="SetInstallDirFromPrevious" After="AppSearch">
        WDS_PREVIOUS_INSTALL AND NOT Installed
      </Custom>
      <Custom Action="ApplyDesktopPrefFromReg" After="SetInstallDirFromPrevious">
        WDS_REG_DESKTOP_PREF
      </Custom>
      <Custom Action="ApplyDesktopPrefLegacyOff" After="ApplyDesktopPrefFromReg">
        NOT WDS_REG_DESKTOP_PREF AND WDS_PREVIOUS_INSTALL AND NOT WDS_REG_DESKTOP_LEGACY AND NOT Installed
      </Custom>
      <Custom Action="ApplyStartMenuPrefFromReg" After="ApplyDesktopPrefLegacyOff">
        WDS_REG_STARTMENU_PREF
      </Custom>
      <Custom Action="ApplyStartMenuPrefLegacyOff" After="ApplyStartMenuPrefFromReg">
        NOT WDS_REG_STARTMENU_PREF AND WDS_PREVIOUS_INSTALL AND NOT WDS_REG_STARTMENU_LEGACY AND NOT Installed
      </Custom>
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="SetInstallDirFromPrevious" After="AppSearch">
        WDS_PREVIOUS_INSTALL AND NOT Installed
      </Custom>
      <!-- Quiet installs have no ShortcutsDlg; mirror registry prefs here only. -->
      <Custom Action="ApplyDesktopPrefFromReg" After="SetInstallDirFromPrevious">
        UILevel=2 AND WDS_REG_DESKTOP_PREF
      </Custom>
      <Custom Action="ApplyDesktopPrefLegacyOff" After="ApplyDesktopPrefFromReg">
        UILevel=2 AND NOT WDS_REG_DESKTOP_PREF AND WDS_PREVIOUS_INSTALL AND NOT WDS_REG_DESKTOP_LEGACY AND NOT Installed
      </Custom>
      <Custom Action="ApplyStartMenuPrefFromReg" After="ApplyDesktopPrefLegacyOff">
        UILevel=2 AND WDS_REG_STARTMENU_PREF
      </Custom>
      <Custom Action="ApplyStartMenuPrefLegacyOff" After="ApplyStartMenuPrefFromReg">
        UILevel=2 AND NOT WDS_REG_STARTMENU_PREF AND WDS_PREVIOUS_INSTALL AND NOT WDS_REG_STARTMENU_LEGACY AND NOT Installed
      </Custom>
      <!-- Re-apply after MigrateFeatureStates so upgrade feature migration cannot
           discard ShortcutsDlg AddLocal/Remove (or silent registry prefs). -->
      <Custom Action="ApplyShortcutFeatureStates" After="MigrateFeatureStates">
        NOT Installed
      </Custom>
      <Custom Action="PersistDesktopShortcutOn" Before="WriteRegistryValues">
        CREATE_DESKTOP_SHORTCUT="1"
      </Custom>
      <Custom Action="PersistDesktopShortcutOff" Before="PersistDesktopShortcutOn">
        NOT CREATE_DESKTOP_SHORTCUT="1"
      </Custom>
      <Custom Action="PersistStartMenuShortcutOn" Before="PersistDesktopShortcutOff">
        CREATE_STARTMENU_SHORTCUT="1"
      </Custom>
      <Custom Action="PersistStartMenuShortcutOff" Before="PersistStartMenuShortcutOn">
        NOT CREATE_STARTMENU_SHORTCUT="1"
      </Custom>
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="WDS Editor"/>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="WDS Editor"/>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop"/>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="C8D9E0F1-2A3B-4C5D-6E7F-8091A2B3C4D5" Win64="yes">
        <Shortcut Id="WdsEditorStartMenu"
                  Name="WDS Editor"
                  Description="World Dai Star chart editor"
                  Target="[INSTALLDIR]wds_editor.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="WdsEditorIcon"
                  IconIndex="0"/>
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\WDS\Editor"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="D9E0F1A2-3B4C-5D6E-7F80-91A2B3C4D5E6" Win64="yes">
        <Shortcut Id="WdsEditorDesktop"
                  Name="WDS Editor"
                  Description="World Dai Star chart editor"
                  Target="[INSTALLDIR]wds_editor.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="WdsEditorIcon"
                  IconIndex="0"/>
        <RegistryValue Root="HKCU"
                       Key="Software\WDS\Editor"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="RegistryInstallDir" Guid="E0F1A2B3-4C5D-6E7F-8091-A2B3C4D5E6F7" Win64="yes">
        <RegistryValue Root="HKLM"
                       Key="Software\WDS\Editor"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLDIR]"
                       KeyPath="yes"/>
      </Component>
      <!-- Always installed: last-chosen shortcut prefs for the next update UI. -->
      <Component Id="RegistryShortcutPrefs" Guid="F1A2B3C4-5D6E-7F80-91A2-B3C4D5E6F708" Win64="yes">
        <RegistryValue Root="HKLM"
                       Key="Software\WDS\Editor"
                       Name="CreateDesktopShortcut"
                       Type="string"
                       Value="[WDS_DESKTOP_SHORTCUT_PREF]"
                       KeyPath="yes"/>
        <RegistryValue Root="HKLM"
                       Key="Software\WDS\Editor"
                       Name="CreateStartMenuShortcut"
                       Type="string"
                       Value="[WDS_STARTMENU_SHORTCUT_PREF]"/>
      </Component>
    </DirectoryRef>

    <!-- Prefer BMP-only ICO generated at package time (PNG-compressed ICO can crash msiexec UI). -->
    <Icon Id="WdsEditorIcon" SourceFile="$(var.SourceDir)/wds-msi.ico"/>

    <Feature Id="ProductFeature" Title="WDS Editor" Level="1">
      <ComponentGroupRef Id="ProductFiles"/>
      <ComponentRef Id="RegistryInstallDir"/>
      <ComponentRef Id="RegistryShortcutPrefs"/>
    </Feature>
    <Feature Id="StartMenuFeature" Title="Start Menu Shortcut" Level="1">
      <ComponentRef Id="ApplicationShortcut"/>
    </Feature>
    <Feature Id="DesktopFeature" Title="Desktop Shortcut" Level="1">
      <ComponentRef Id="DesktopShortcut"/>
    </Feature>
  </Product>
</Wix>
