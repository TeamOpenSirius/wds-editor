<?xml version="1.0" encoding="utf-8"?>
<!--
  First-run / reinstall UI for WDS Editor MSI (wixl ext ui).

  Sequence:
    InstallDirDlg      - choose install path (fresh install, and the one-time
                         migration off a leftover Id='*' product)
    MaintenanceTypeDlg - the stock three-button maintenance screen (Change /
                         Repair / Remove), shown only when this exact build is
                         already installed, so repairing is an explicit click.
                         Change is greyed out by ARPNOMODIFY=1. The stock
                         VerifyReadyDlg wires the other two:
                           Repair -> ReinstallMode=ecmus + Reinstall=All
                           Remove -> Remove=All
    UpdateDlg          - a different build is installed, or a leftover Id='*'
                         product was detected; no path picker
    ShortcutsDlg       - desktop / Start Menu shortcut checkboxes
    ProgressDlg        - from UI extension
    ExitDialog         - completion

  Repair and update need separate entry points. The same .msi file (same
  ProductCode + same stamp) shows the maintenance screen. A newer dest MSI
  has a new ProductCode, so Installed is 0 and FindRelatedProducts sets
  WIX_UPGRADE_DETECTED: that path, an older install with no stamp, or a
  leftover Id='*' product all go straight to UpdateDlg.

  MaintenanceWelcomeDlg stays out of the sequence (Condition="0") so the three
  buttons are the first thing a repairer sees; MaintenanceTypeDlg's Back still
  opens it, and its Next comes back here. Add a Show row for it if the classic
  Welcome -> three buttons pair is wanted instead.

  Notes for wixl 0.103:
  - Folder is Edit (not PathEdit). PathEdit validates the path and clears the
    property when C:\Program Files\WDS Editor does not exist yet — first
    install then writes files nowhere useful; Repair skips this dialog.
  - wixl ignores Indirect, so we cannot bind PathEdit to the Directory property
  - BrowseDlg is custom; OK runs SetInstallDirFromBrowse to append \WDS Editor
  - Unchecked boxes clear the property; Next writes explicit "0" so
    SecureCustomProperties passes the off state into elevated Execute
  - Shortcuts are Shortcut-table components gated by CREATE_*
    (Component.Condition is patched after wixl; 0.103 cannot parse it)
  - Defaults on update come from HKLM via AppSearch. CREATE_* must NOT have
    a Property-table value: AppSearch will not overlay one, and a baked-in
    1 made every rebuild show both boxes checked. The default 1 is a Type 51
    CA that runs only when the search found nothing.
  - CREATE_* / WDS_INSTALLDIR / INSTALLDIR / REINSTALL are appended to
    SecureCustomProperties after wixl
  - ASCII UI strings only (MSI codepage 1252)
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <UI Id="WdsUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8"/>
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12"/>
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes"/>

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal"/>
      <Property Id="WixUI_Mode" Value="Wds"/>
      <Property Id="ARPNOMODIFY" Value="1"/>

      <DialogRef Id="ErrorDlg"/>
      <DialogRef Id="FatalError"/>
      <DialogRef Id="FilesInUse"/>
      <DialogRef Id="MsiRMFilesInUse"/>
      <DialogRef Id="PrepareDlg"/>
      <DialogRef Id="ProgressDlg"/>
      <DialogRef Id="ResumeDlg"/>
      <DialogRef Id="UserExit"/>
      <DialogRef Id="CancelDlg"/>
      <DialogRef Id="MaintenanceWelcomeDlg"/>
      <DialogRef Id="MaintenanceTypeDlg"/>
      <DialogRef Id="VerifyReadyDlg"/>
      <DialogRef Id="ExitDialog"/>

      <Dialog Id="InstallDirDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Choose Install Location"/>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Choose where to install [ProductName]."/>
        <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="330" Height="20" NoPrefix="yes"
                 Text="Folder:"/>
        <Control Id="Folder" Type="Edit" X="20" Y="100" Width="245" Height="18"
                 Property="WDS_INSTALLDIR"/>
        <Control Id="Browse" Type="PushButton" X="275" Y="99" Width="75" Height="20" Text="Browse...">
          <!-- Start the folder picker under Program Files; OK appends \WDS Editor. -->
          <Publish Property="WDSINSTALLPARENT" Value="[ProgramFiles64Folder]" Order="1">1</Publish>
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
        </Control>
        <Control Id="PathHint" Type="Text" X="20" Y="130" Width="330" Height="50" NoPrefix="yes"
                 Text="Type a full destination path, or use Browse to pick a parent folder. Browse always appends \WDS Editor."/>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Back"/>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
          <Publish Event="DoAction" Value="ApplyWdsInstallDir" Order="1">1</Publish>
          <Publish Event="SetTargetPath" Value="INSTALLDIR" Order="2">1</Publish>
          <Publish Event="NewDialog" Value="ShortcutsDlg" Order="3">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <!--
        Folder browser popup. wixl has no stock BrowseDlg and ignores Indirect,
        so we browse WDSINSTALLPARENT (a plain path property) then append the
        product folder name via SetInstallDirFromBrowse.

        Control_First must participate in a closed Control_Next loop (error 2834
        otherwise). Mirror InstallDirDlg: lead with BannerBitmap, then buttons.
      -->
      <Dialog Id="BrowseDlg" Width="370" Height="270" Title="Browse for Folder">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
        <Control Id="Description" Type="Text" X="25" Y="50" Width="320" Height="28" Transparent="yes" NoPrefix="yes"
                 Text="Select a parent folder. Files install into a WDS Editor subfolder."/>
        <Control Id="ComboLabel" Type="Text" X="25" Y="82" Width="55" Height="13" NoPrefix="yes"
                 Text="Look in:"/>
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="80" Y="79" Width="200" Height="80"
                 Property="WDSINSTALLPARENT" Fixed="yes" Remote="yes"/>
        <Control Id="Up" Type="PushButton" X="290" Y="79" Width="30" Height="19" Text="Up">
          <Publish Event="DirectoryListUp" Value="0">1</Publish>
        </Control>
        <Control Id="NewFolder" Type="PushButton" X="325" Y="79" Width="30" Height="19" Text="New">
          <Publish Event="DirectoryListNew" Value="0">1</Publish>
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="25" Y="104" Width="320" Height="70"
                 Property="WDSINSTALLPARENT" Sunken="yes"/>
        <Control Id="PathLabel" Type="Text" X="25" Y="180" Width="320" Height="13" NoPrefix="yes"
                 Text="Folder:"/>
        <Control Id="PathEdit" Type="PathEdit" X="25" Y="196" Width="320" Height="18"
                 Property="WDSINSTALLPARENT"/>
        <Control Id="OK" Type="PushButton" X="180" Y="243" Width="56" Height="17" Default="yes" Text="OK">
          <Publish Event="DoAction" Value="SetInstallDirFromBrowse" Order="1">1</Publish>
          <Publish Event="DoAction" Value="InitWdsInstallDir" Order="2">1</Publish>
          <Publish Event="SetTargetPath" Value="INSTALLDIR" Order="3">1</Publish>
          <Publish Event="EndDialog" Value="Return" Order="4">1</Publish>
        </Control>
        <Control Id="CancelBrowse" Type="PushButton" X="244" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="UpdateDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Update [ProductName]"/>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="This setup will update your existing installation."/>
        <Control Id="UpdateInfo" Type="Text" X="20" Y="70" Width="330" Height="100" NoPrefix="yes"
                 Text="A different build of [ProductName] is installed, or an older installation is being replaced. Files will be updated in place; the install folder cannot be changed.&#xA;&#xA;Install folder:&#xA;[WDS_INSTALLDIR]&#xA;&#xA;User settings under %LOCALAPPDATA%\WDS are kept. Apps &amp; Features keeps a single entry."/>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Back"/>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
          <!-- Already installed: reinstall in place, never retarget INSTALLDIR.
               REINSTALLMODE is deliberately NOT published here: the execute
               sequence picks it from the build stamp, omus (same MSI -> repair)
               or vamus (different build -> update), and those actions become
               the authority for silent installs too. -->
          <Publish Property="REINSTALL" Value="ALL" Order="1" Condition="Installed"/>
          <!-- Leftover Id='*' product: new ProductCode install over remembered path. -->
          <Publish Event="DoAction" Value="ApplyWdsInstallDir" Order="2" Condition="NOT Installed"/>
          <Publish Event="SetTargetPath" Value="INSTALLDIR" Order="3" Condition="NOT Installed"/>
          <Publish Event="NewDialog" Value="ShortcutsDlg" Order="4">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Shortcut Options"/>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Choose which shortcuts to create."/>
        <Control Id="DesktopCheck" Type="CheckBox" X="20" Y="80" Width="330" Height="20"
                 Property="CREATE_DESKTOP_SHORTCUT" CheckBoxValue="1"
                 Text="Create a desktop shortcut"/>
        <Control Id="StartMenuCheck" Type="CheckBox" X="20" Y="110" Width="330" Height="20"
                 Property="CREATE_STARTMENU_SHORTCUT" CheckBoxValue="1"
                 Text="Create a Start Menu shortcut"/>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" Order="1"
                   Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT WIX_SAME_VERSION_UPGRADE_DETECTED"/>
          <Publish Event="NewDialog" Value="UpdateDlg" Order="2"
                   Condition="Installed OR WIX_UPGRADE_DETECTED OR WIX_SAME_VERSION_UPGRADE_DETECTED"/>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Install">
          <!-- CheckBox clears the property when unchecked; SecureCustomProperties only
               forwards *set* values, so an empty CREATE_* leaves Execute at default "1".
               wixl only honors Condition= attribute (not Publish element body). -->
          <Publish Property="CREATE_DESKTOP_SHORTCUT" Value="0" Order="1"
                   Condition="NOT CREATE_DESKTOP_SHORTCUT=&quot;1&quot;"/>
          <Publish Property="CREATE_STARTMENU_SHORTCUT" Value="0" Order="2"
                   Condition="NOT CREATE_STARTMENU_SHORTCUT=&quot;1&quot;"/>
          <Publish Event="EndDialog" Value="Return" Order="3">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed AND NOT PATCH"/>

      <InstallUISequence>
        <!-- After InitWdsInstallDir so the path text is the resolved folder. -->
        <Show Dialog="InstallDirDlg" After="InitWdsInstallDir" Overridable="yes"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT WIX_SAME_VERSION_UPGRADE_DETECTED"/>
        <!-- This exact build is already installed: show the stock three-button
             maintenance screen so repairing is a deliberate click. Change is
             disabled by ARPNOMODIFY, and Repair/Remove are wired by the stock
             VerifyReadyDlg. A leftover Id='*' product takes precedence over
             repair, hence the WIX_* exclusions - there really is something to
             update in that case. "&lt;>" is msiexec's not-equal operator,
             escaped because this is XML. -->
        <Show Dialog="MaintenanceTypeDlg" After="InitWdsInstallDir" Overridable="yes"
              Condition="Installed AND WDS_INSTALLED_TS = WDS_BUILD_TS AND NOT WIX_UPGRADE_DETECTED AND NOT WIX_SAME_VERSION_UPGRADE_DETECTED"/>
        <!-- A different build, a leftover Id='*' product, or an older install
             that predates the stamp: straight to the update flow, no choice. -->
        <Show Dialog="UpdateDlg" After="InitWdsInstallDir" Overridable="yes"
              Condition="(Installed AND (NOT WDS_INSTALLED_TS OR WDS_INSTALLED_TS &lt;> WDS_BUILD_TS)) OR WIX_UPGRADE_DETECTED OR WIX_SAME_VERSION_UPGRADE_DETECTED"/>
        <!-- Repair/Remove are offered by RepairDlg, not by the stock wizard. -->
        <Show Dialog="MaintenanceWelcomeDlg" Before="ProgressDlg" Overridable="yes"
              Condition="0"/>
        <Show Dialog="ExitDialog" OnExit="success" Overridable="yes"/>
      </InstallUISequence>
    </UI>

    <UIRef Id="WixUI_Common"/>
  </Fragment>
</Wix>
