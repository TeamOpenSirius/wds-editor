.vscode/
.cursor/
*.user
*.suo
*.code-workspace

# --- Build outputs / caches ---
/build/
/build-*/
/dist/
/.cache/
.cache/
CMakeCache.txt
CMakeFiles/
cmake-build-*/
compile_commands.json
.clangd/
.cmake/

# --- Machine-local secrets / absolute paths ---
/scripts/env.local
.env
.env.local
.env.*.local

# Local tool checkouts dropped inside the repo
/vcpkg/
/VulkanSDK/
/sonolus-sirius-engine/

# Local Unity/IL2CPP dumps (not part of the editor)
/wds/

# MSI Binary-table dumps (not build inputs; WixUI assets come from wixl-data)
/Binary/

# Optional local-only docs
/docs/

# Optional sample BGM for local testing
