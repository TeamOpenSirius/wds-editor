#include <winver.h>

// Explorer/taskbar icon embedded in the PE. QApplication::setWindowIcon only
// affects the running window; Windows requires an ICON resource for the .exe.
IDI_APP_ICON ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/assets/app_icon/wds.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "WDS Editor"
      VALUE "FileVersion", "@WDS_APP_VERSION@"
      VALUE "ProductName", "WDS Editor"
      VALUE "ProductVersion", "@WDS_APP_VERSION@"
      VALUE "OriginalFilename", "wds_editor.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
